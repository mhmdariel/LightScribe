٥. نَمُوذَجُ QASM لِلنَّوَاةِ الْكَمِّيَّةِ

OpenQASM 3

OPENQASM 3;

include "stdgates.inc";

qubit[8] q;
bit[8] c;

// تَهْيِئَةُ الْحَالَةِ
h q[0];
h q[1];
h q[2];

// تَرَابُطٌ كَمِّيٌّ
cx q[0], q[3];
cx q[1], q[4];
cx q[2], q[5];

// تَرْمِيزُ الدَّلَالَةِ
rz(pi/4) q[3];
rz(pi/3) q[4];
rz(pi/2) q[5];

// شَبَكَةُ الِاسْتِنْتَاجِ
h q[6];
cx q[3], q[6];
cx q[4], q[6];
cx q[5], q[6];

// التَّحَقُّق
x q[7];
cz q[6], q[7];

// الْقِيَاس
measure q -> c;


