١٢. مِثَالُ تَنْفِيذٍ هَجِين

Python + QASM

from qiskit import QuantumCircuit
from qiskit_aer import AerSimulator

qc = QuantumCircuit(3, 3)

qc.h(0)
qc.cx(0, 1)
qc.rz(1.57, 1)
qc.cx(1, 2)

qc.measure([0,1,2], [0,1,2])

sim = AerSimulator()
result = sim.run(qc).result()
print(result.get_counts())


