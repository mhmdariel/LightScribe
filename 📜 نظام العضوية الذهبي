class العضويةالذهبية {
  constructor(اسمالمؤمن) {
    this.الاسم = اسمالمؤمن;
    this.المستوى = "مبتدئ";
    this.النقاط = 0;
    this.المكتبةالشخصية = [];
  }

  زيادةالإيمان(كمية) {
    this.النقاط += كمية;
    
    if (this.النقاط >= 1000) {
      this.المستوى = "مقرب";
      this.المكتبةالشخصية.push("خزانة خاصة في السماء الرابعة");
    } else if (this.النقاط >= 500) {
      this.المستوى = "خاص";
      this.المكتبةالشخصية.push("مكتبة ذهبية متنقلة");
    } else if (this.النقاط >= 100) {
      this.المستوى = "ذهبي";
      this.المكتبةالشخصية.push("مجموعة كتب ألماسية");
    }

    return {
      مستوى: this.المستوى,
      نقاط: this.النقاط,
      هدايا: this.المكتبةالشخصية
    };
  }

  استعارةكتاب(نوعالكتاب) {
    const مكتبة = new مكتبةخزائنالله();
    const الكتاب = مكتبة.الأقسام[نوعالكتاب];
    
    if (الكتاب && this.النقاط >= 50) {
      return {
        نجاح: true,
        كتاب: الكتاب[0],
        مدة: "مفتوحة حتى الممات",
        شرط: "أن تنتفع وتنفع"
      };
    }
    
    return {
      نجاح: false,
      رسالة: "زد إيماناً لتحصل على الكنوز"
    };
  }
}
